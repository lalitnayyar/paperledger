# Safe default: available only on the Docker host's localhost.
APP_PORT=8080
APP_BIND_ADDR=127.0.0.1
# Use manage.sh to create the first administrator after starting the app.
# User accounts and password hashes are stored in the persistent data volume.
# Optional Fernet key. Generate it with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up securely and keep it unchanged when restarting or upgrading.
# APP_ENCRYPTION_KEY=
